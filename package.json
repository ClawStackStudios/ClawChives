{
  "name": "claw-chives",
  "private": true,
  "version": "3.3.1",
  "type": "module",
  "scripts": {
    "scuttle": "npm run scuttle:dev-start",
    "scuttle:prod": "npm run scuttle:prod-start",
    "scuttle:dev-start": "npm run dev:server & npm run dev",
    "scuttle:dev-stop": "fuser -k 4545/tcp 4646/tcp || true",
    "scuttle:prod-start": "npm run build && (NODE_ENV=production PORT=4646 tsx server.ts & vite preview --port 4545 --host)",
    "scuttle:prod-stop": "npm run scuttle:dev-stop",
    "scuttle:reset": "npm run scuttle:stop && tsx scripts/scuttle-reset.ts --env production && rm -rf dist",
    "scuttle:dev-reset": "npm run scuttle:stop && tsx scripts/scuttle-reset.ts --env development",
    "scuttle:stop": "npm run scuttle:dev-stop",
    "dev": "vite --port 4545 --strictPort",
    "dev:server": "DATA_DIR=./data-dev PORT=4646 tsx --watch server.ts",
    "start:api": "tsx server.ts",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:phase3:build": "vitest run tests/build-gates.test.ts",
    "test:phase3:integration": "vitest run tests/phase3-integration.test.ts",
    "test:phase3:full": "npm run test && npm run test:phase3:integration && npm run test:phase3:build",
    "test:lobster-session": "vitest run tests/lobster-session.test.ts",
    "test:admin": "vitest run tests/admin-dashboard.test.ts",
    "test:phase4:full": "npm run test && npm run test:lobster-session && npm run test:phase3:build"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "better-sqlite3-multiple-ciphers": "^9.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.36.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.38",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
