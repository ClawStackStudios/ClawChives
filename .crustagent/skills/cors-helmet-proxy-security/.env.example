# ─── CORS-Helmet-Proxy Security Skill Environment Configuration ────────────────
# Copy this file to .env and configure for your deployment
# ──────────────────────────────────────────────────────────────────────────────

# ── Deployment Mode ─────────────────────────────────────────────────────────────
# Controls CORS behavior and security level
#
# Development: Allow localhost and private IPs (192.168.x.x, 10.x.x.x, etc.)
# LAN: Allow private network access
# Production: Restrict to specific domain (Cloudflare Tunnel)
# NODE_ENV=development

# ── CORS Configuration ──────────────────────────────────────────────────────────
# Required for production mode. Comma-separated list of allowed origins.
#
# Development/LAN: Leave empty for automatic private IP detection
# Production: Set to your domain (e.g., https://yourdomain.cf)
# CORS_ORIGIN=

# ── Reverse Proxy Configuration ──────────────────────────────────────────────────
# Enable when running behind a reverse proxy
#
# Cloudflare Tunnel: REQUIRED - Trusts CF headers for real IP detection
# Nginx/Docker: Enable to get real client IP instead of proxy IP
# TRUST_PROXY=false

# ── HTTPS Enforcement ────────────────────────────────────────────────────────────
# Force HTTPS redirects (recommended for production)
#
# Set to true for production deployments
# ENFORCE_HTTPS=false

# ── Port Configuration ───────────────────────────────────────────────────────────
# HTTPS port for redirect (when ENFORCE_HTTPS=true)
# HTTPS_PORT=443

# ── Rate Limiting (Optional) ────────────────────────────────────────────────────
# Customize rate limiting behavior
#
# Auth endpoint protection (prevents brute force)
AUTH_RATE_WINDOW=900000        # 15 minutes (ms)
AUTH_RATE_LIMIT=5              # Max 5 attempts per window

# General API rate limiting (prevents abuse)
API_RATE_WINDOW=60000          # 1 minute (ms)
API_RATE_LIMIT=100             # Max 100 requests per window

# ─── Cloudflare Tunnel Setup ───────────────────────────────────────────────────
# Uncomment and set these when using Cloudflare Tunnel
#
# CORS_ORIGIN=https://yourdomain.cf
# TRUST_PROXY=true
# ENFORCE_HTTPS=true

# ─── Docker Setup ──────────────────────────────────────────────────────────────
# When deploying to Docker, typically use:
#
# TRUST_PROXY=true
# CORS_ORIGIN=https://your-domain.com
# ENFORCE_HTTPS=true
# NODE_ENV=production