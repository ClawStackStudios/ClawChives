{
  "name": "my-new-project",
  "version": "1.0.0",
  "description": "Example project using CORS-Helmet-Proxy Security Skill",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "security-test": "npm run build && npm run test:security"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "tsx": "^4.6.2"
  },
  "securityConfig": {
    "skill": "@.crustagent/skills/cors-helmet-proxy-security",
    "version": "1.0.0",
    "features": [
      "Smart CORS (3 modes)",
      "Helmet security headers",
      "Trusted proxy support",
      "HTTPS enforcement",
      "Rate limiting"
    ]
  }
}